# SSD Nets-Service — environment template.
# Copy to `.env` in this same directory and fill in real values before
# deployment. Nothing here is committed with a real secret — see the
# rebrand/secrets-cleanup note in the SSD conversion work: this file
# previously carried HEB's own live production credentials (copied along
# with the rest of the repo when SSD's Nets-Service was forked from HEB's),
# which have since been blanked out.

# Local HTTP/Socket.IO port this service listens on. SSD's port is 2003
# (HEB's was 5201) — see source/index.js's own fallback constant, which
# must be kept in sync with this value.
port=2003

# SSD-Backend base URL and registration host. Point both at the deployed
# SSD-Backend origin (see SSD-Backend's own PORT/deployment docs) — never a
# `localhost` value in production, since the terminal/printer PC and the
# backend are not the same machine.
URL=
REGISTRATION_HOST=

# Backend admin credentials this service authenticates as, if/where the
# bundled nets-service-sdk still needs them for its own cloud registration
# calls (kept for parity with HEB's config shape — confirm whether SSD's
# deployment actually needs these before filling them in).
user=
password=

# NETS terminal serial port (Windows COM port). Verify against Device
# Manager on the machine the terminal is physically connected to.
COM='COM1'

# SSD's own entity/temple code — matches SSD-Backend's DEFAULT_ENTITY_CODE.
TEMPLE="SST"

# AWS S3 (receipt PDF storage), if SSD's deployment uses it — leave blank if
# not provisioned yet.
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_BUCKET=

# PrintNode printer id + API key, if the physical printer is registered
# through PrintNode rather than a local Windows printer name (see
# config.json's printerName for the alternative, which is what
# amq/printService.js's actual print path uses today).
PRINTER=
printnode=

# Whether the bundled NETS terminal SDK is active. Leave "disable" until a
# real terminal is connected and configured for this deployment.
terminal=disable
authCode=

# MQTT-style topic namespace, if used by the bundled SDK — should read
# "SSD/KIOSK_<n>" rather than HEB's "SSPT/KIOSK_1".
topic=SSD/KIOSK_1

# --- Optional CloudAMQP settings (legacy amq/ integration, commented out
#     unless this deployment actually uses it) ---
# AMQ_HOST=
# AMQ_PORT=5671
# AMQ_USER=
# AMQ_PASSWORD=
# AMQ_QUEUE=
# AMQ_VHOST=
# AMQ_USE_SSL=true

# NETS payment -> SSD-Backend confirmation callback (see SSD-Backend's
# controllers/payments/nets/callback). Must be the EXACT same value set as
# SSD-Backend's own NETS_CALLBACK_SECRET env var, or every automatic payment
# confirmation is rejected with 401. Generate a long random string per
# deployment — do not reuse across environments.
NETS_CALLBACK_SECRET=
