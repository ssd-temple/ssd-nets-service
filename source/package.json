{
    "name":  "kioskservice",
    "version":  "1.0.14",
    "description":  "Kiosk Payment Terminal Service",
    "main":  "index.js",
    "bin":  "index.js",
    "pkg":  {
                "targets":  [
                                "node18-win-x64"
                            ],
                "assets":  [
                               "configPath.js",
                               "config.json",
                               "public/**/*",
                               "node_modules/@serialport/bindings-cpp/prebuilds/win32-x64/node.napi.node",
                               "node_modules/usb/prebuilds/win32-x64/node.napi.node",
                               "node_modules/axios/**/*.js",
                               "node_modules/axios/**/*.cjs",
                               "node_modules/axios/**/*.json",
                               "node_modules/axios/**/*.mjs",
                               "node_modules/canvas/build/Release/canvas.node",
                               "fonts/**/*",
                               "addons/canvas/**/*",
                               "scripts/**/*"
                           ],
                "outputPath":  "dist"
            },
    "scripts":  {
                    "postinstall":  "patch-package",
                    "test":  "jest --coverage --runInBand",
                    "start":  "node index.js",
                    "logon":  "node ./scripts/logon.js",
                    "status":  "node ./scripts/statusCheck.js",
                    "build":  "nexe index.js",
                    "build:win":  "node installer/build-win.js",
                    "build:installer":  "node installer/build-win.js \u0026\u0026 iscc installer/setup.iss",
                    "package":  "ncc build index.js -o dist",
                    "service:menu":  "powershell -ExecutionPolicy Bypass -File ./scripts/manage-context-menu.ps1 -Action install",
                    "test:nets":  "npx jest test/nets_terminal_cases.test.js --verbose --no-coverage"
                },
    "author":  "",
    "license":  "ISC",
    "dependencies":  {
                         "@pokusew/escpos":  "^3.0.8",
                         "amqplib":  "^0.10.3",
                         "aws-sdk":  "^2.1369.0",
                         "axios":  "^1.8.4",
                         "canvas":  "^3.2.1",
                         "cors":  "^2.8.5",
                         "dollars-to-cents":  "^1.0.3",
                         "dotenv":  "^16.0.3",
                         "escpos":  "2.3.2",
                         "escpos-buffer":  "^3.1.0",
                         "escpos-serialport":  "^3.0.0-alpha.4",
                         "escpos-usb":  "^3.0.0-alpha.4",
                         "express":  "^4.21.2",
                         "express-requests-logger":  "^4.0.0",
                         "fs":  "0.0.1-security",
                         "iconv-lite":  "^0.7.2",
                         "lodash":  "^4.17.21",
                         "moment":  "^2.29.4",
                         "mutable-buffer":  "^2.2.2",
                         "nets-service-sdk":  "^1.1.21",
                         "node-cron":  "^3.0.2",
                         "node-printer":  "^1.0.4",
                         "path":  "^0.12.7",
                         "pdf-to-base64":  "^1.0.3",
                         "pdfkit":  "^0.13.0",
                         "pdfmake":  "^0.2.7",
                         "receiptline":  "^1.15.0",
                         "request":  "^2.88.2",
                         "serialport":  "^10.5.0",
                         "socket.io":  "^4.8.1",
                         "socket.io-client":  "^4.7.2",
                         "usb":  "^2.9.0",
                         "winston":  "^3.8.2",
                         "winston-daily-rotate-file":  "^5.0.0"
                     },
    "devDependencies":  {
                            "@vercel/ncc":  "^0.38.3",
                            "jest":  "^29.7.0",
                            "nexe":  "^5.0.0-beta.4",
                            "patch-package":  "^8.0.1",
                            "pkg":  "^5.8.1"
                        }
}